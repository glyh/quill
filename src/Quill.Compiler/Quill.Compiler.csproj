<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Quill.Kernel\Quill.Kernel.csproj" />
    <ProjectReference Include="..\Quill.Expand\Quill.Expand.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Quill.Tests asserts an exact error constructor (the evidence-desync invariant). -->
    <InternalsVisibleTo Include="Quill.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The prelude's source, the port's own copy (docs/wayfinder/tickets/port-core-tt-to-dotnet.md). -->
    <EmbeddedResource Include="..\..\std\*.qll" LogicalName="std/%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
