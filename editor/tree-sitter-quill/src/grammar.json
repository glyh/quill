{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "quill",
  "word": "identifier",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_item"
      }
    },
    "_item": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_group"
        },
        {
          "type": "SYMBOL",
          "name": "_token"
        },
        {
          "type": "SYMBOL",
          "name": "_unexpected"
        }
      ]
    },
    "_group": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "paren_group"
        },
        {
          "type": "SYMBOL",
          "name": "bracket_group"
        },
        {
          "type": "SYMBOL",
          "name": "brace_group"
        }
      ]
    },
    "paren_group": {
      "type": "PREC",
      "value": 1,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "("
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "SYMBOL",
              "name": "_item"
            }
          },
          {
            "type": "STRING",
            "value": ")"
          }
        ]
      }
    },
    "bracket_group": {
      "type": "PREC",
      "value": 1,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "["
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "SYMBOL",
              "name": "_item"
            }
          },
          {
            "type": "STRING",
            "value": "]"
          }
        ]
      }
    },
    "brace_group": {
      "type": "PREC",
      "value": 1,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "{"
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "SYMBOL",
              "name": "_item"
            }
          },
          {
            "type": "STRING",
            "value": "}"
          }
        ]
      }
    },
    "_token": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "keyword"
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
        },
        {
          "type": "SYMBOL",
          "name": "integer"
        },
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "char"
        },
        {
          "type": "SYMBOL",
          "name": "operator"
        },
        {
          "type": "SYMBOL",
          "name": "datum_comment"
        },
        {
          "type": "SYMBOL",
          "name": "sigil"
        },
        {
          "type": "SYMBOL",
          "name": "_punct"
        }
      ]
    },
    "_punct": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": ","
        },
        {
          "type": "STRING",
          "value": "."
        },
        {
          "type": "STRING",
          "value": ":"
        },
        {
          "type": "STRING",
          "value": ";"
        },
        {
          "type": "STRING",
          "value": "="
        },
        {
          "type": "STRING",
          "value": "|"
        },
        {
          "type": "STRING",
          "value": "->"
        }
      ]
    },
    "keyword": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "let"
        },
        {
          "type": "STRING",
          "value": "fun"
        },
        {
          "type": "STRING",
          "value": "sig"
        },
        {
          "type": "STRING",
          "value": "fn"
        },
        {
          "type": "STRING",
          "value": "do"
        },
        {
          "type": "STRING",
          "value": "match"
        },
        {
          "type": "STRING",
          "value": "effect"
        },
        {
          "type": "STRING",
          "value": "module"
        },
        {
          "type": "STRING",
          "value": "struct"
        },
        {
          "type": "STRING",
          "value": "enum"
        },
        {
          "type": "STRING",
          "value": "impl"
        },
        {
          "type": "STRING",
          "value": "trait"
        },
        {
          "type": "STRING",
          "value": "pub"
        },
        {
          "type": "STRING",
          "value": "import"
        },
        {
          "type": "STRING",
          "value": "open"
        },
        {
          "type": "STRING",
          "value": "export"
        },
        {
          "type": "STRING",
          "value": "macro"
        },
        {
          "type": "STRING",
          "value": "pattern"
        },
        {
          "type": "STRING",
          "value": "self"
        },
        {
          "type": "STRING",
          "value": "Self"
        },
        {
          "type": "STRING",
          "value": "ref"
        },
        {
          "type": "STRING",
          "value": "deref"
        },
        {
          "type": "STRING",
          "value": "rec"
        },
        {
          "type": "STRING",
          "value": "perform"
        },
        {
          "type": "STRING",
          "value": "resume"
        },
        {
          "type": "STRING",
          "value": "method"
        }
      ]
    },
    "sigil": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "$"
        },
        {
          "type": "STRING",
          "value": "^"
        }
      ]
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[A-Za-z_][A-Za-z0-9_?!]*"
    },
    "integer": {
      "type": "PATTERN",
      "value": "[0-9]+"
    },
    "string": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "\""
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "PATTERN",
                  "value": "[^\"\\\\]"
                },
                {
                  "type": "PATTERN",
                  "value": "\\\\."
                }
              ]
            }
          },
          {
            "type": "STRING",
            "value": "\""
          }
        ]
      }
    },
    "char": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "'"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "PATTERN",
                "value": "[^'\\\\\\n\\r]"
              },
              {
                "type": "PATTERN",
                "value": "\\\\[ntr\\\\'\"]"
              }
            ]
          },
          {
            "type": "STRING",
            "value": "'"
          }
        ]
      }
    },
    "operator": {
      "type": "PATTERN",
      "value": "[+\\-*/%!=<>@~&|]+"
    },
    "datum_comment": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "STRING",
          "value": "#_"
        }
      }
    },
    "doc_comment": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "##[^\\n]*"
        }
      }
    },
    "line_comment": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "#([^_\\n|][^\\n]*)?"
        }
      }
    },
    "_unexpected": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -1,
        "content": {
          "type": "PATTERN",
          "value": "[^ \\t\\r\\n]"
        }
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "[\\s]"
    },
    {
      "type": "SYMBOL",
      "name": "line_comment"
    },
    {
      "type": "SYMBOL",
      "name": "doc_comment"
    },
    {
      "type": "SYMBOL",
      "name": "block_comment"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [
    {
      "type": "SYMBOL",
      "name": "block_comment"
    }
  ],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}